{
  "name": "vite-pug-sass-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Vite starter for multi-page Pug + Sass + JavaScript sites with testing, linting and Husky pre-commit hooks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sass": "stylelint \"src/**/*.sass\"",
    "lint:sass:fix": "stylelint \"src/**/*.sass\" --fix",
    "prepare": "husky"
  },
  "keywords": [
    "vite",
    "pug",
    "sass",
    "sass-indented",
    "javascript",
    "multipage",
    "starter",
    "frontend",
    "boilerplate"
  ],
  "author": "Noah Bravo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahbravo/vite-pug-sass-starter.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@vituum/vite-plugin-pug": "^2.0.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.4.0",
    "postcss-sass": "^0.5.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.94.2",
    "stylelint": "^17.8.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.4",
    "vituum": "^2.0.1"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.sass": [
      "stylelint --fix"
    ]
  }
}
